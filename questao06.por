programa {
  funcao inicio() {
    cadeia disciplina
    cadeia ano
    escreva("Informe a disciplina que você está cursando: ")
    leia(disciplina)
    escreva("Informe qual ano você está cursando na universidade: ")
    leia(ano)
    escreva("Você está cursando ",disciplina," em seu ",ano,"º ano na universidade!")
  }
}
